# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# PostgreSQL (e.g. Neon, Supabase, local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional — full-length YouTube search & playback.
# Leave this unset to use the keyless iTunes Search provider (30-second previews),
# so in-app song search works with zero extra setup.
# Get a key from https://console.cloud.google.com/ (enable "YouTube Data API v3").
# YOUTUBE_API_KEY=""

# ── In-room video calling (optional) ────────────────────────────────────────
# Sphere uses LiveKit for integrated audio/video calls and screen sharing.
# Leave these unset and calls are cleanly disabled (the API returns 503 and the
# call dock hides itself). Secrets are only ever read server-side.
#   LIVEKIT_URL     — your LiveKit websocket URL, e.g. wss://your-project.livekit.cloud
#   LIVEKIT_API_KEY — server API key
#   LIVEKIT_API_SECRET — server API secret
# LIVEKIT_URL=""
# LIVEKIT_API_KEY=""
# LIVEKIT_API_SECRET=""

# ── AI room companion (optional) ────────────────────────────────────────────
# Powered by Groq (https://console.groq.com/keys) via its OpenAI-compatible API.
# The model only proposes search queries; Sphere resolves them against the real
# provider and nothing is ever queued automatically. Unset = the AI dialog
# explains it is disabled.
#   GROQ_API_KEY  — API key from https://console.groq.com/keys (alias: AI_API_KEY)
#   AI_MODEL      — optional model id (default openai/gpt-oss-20b;
#                   openai/gpt-oss-120b is the larger, higher-quality option)
#   AI_BASE_URL   — optional base URL (default https://api.groq.com/openai/v1)
#   AI_TIMEOUT_MS — optional request timeout in ms (default 20000)
# GROQ_API_KEY=""
# AI_MODEL=""
# AI_BASE_URL=""
# AI_TIMEOUT_MS=""
