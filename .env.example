# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# PostgreSQL (e.g. Neon, Supabase, local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional — full-length YouTube search & playback.
# Leave this unset to use the keyless iTunes Search provider (30-second previews),
# so in-app song search works with zero extra setup.
# Get a key from https://console.cloud.google.com/ (enable "YouTube Data API v3").
# YOUTUBE_API_KEY=""
